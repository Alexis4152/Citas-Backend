# Variables de entorno del backend. Copia este archivo a .env (ignorado por git) o defínelas
# en Coolify > Environment Variables. Las que no definas usan el default de application.properties.

# --- Base de datos ---
# DB_URL=
# DB_USERNAME=
DB_PASSWORD=

# --- Seguridad (OBLIGATORIO en producción) ---
APP_JWT_SECRET=
APP_COOKIE_SECURE=true

# --- URLs (opcionales: descomenta solo las que cambies) ---
# APP_PUBLIC_URL=
# APP_FRONTEND_URL=
# APP_CORS_ALLOWED_ORIGINS=
# APP_UPLOADS_DIR=

# --- OpenPay (sin default: se deben definir siempre) ---
OPENPAY_PRIVATE_KEY=
OPENPAY_WEBHOOK_PASSWORD=
# Opcionales (tienen default de sandbox)
# OPENPAY_MERCHANT_ID=
# OPENPAY_PUBLIC_KEY=
# OPENPAY_WEBHOOK_USER=
# OPENPAY_PRODUCTION=false
# OPENPAY_BASE_URL=https://sandbox-api.openpay.mx/v1
